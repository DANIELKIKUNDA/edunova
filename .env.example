EDUNOVA_ENV=development
DATABASE_URL=postgresql+psycopg://edunova:edunova@postgres:5432/edunova
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters-before-production
# Phase 15 v0.50.6: optional dedicated HMAC key for statistical archive proofs.
# 32+ unpredictable characters; if blank, JWT_SECRET is used. Key rotation
# invalidates old archive proofs (safe failure: no historical disclosure).
INSTITUTIONAL_ANALYTICS_HMAC_SECRET=
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
PREMIUM_PRICE_CDF=3000
PREMIUM_AI_CREDITS=25
AI_PACK_10_PRICE_CDF=0
AI_PACK_25_PRICE_CDF=0
AI_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
OCR_PROVIDER=disabled

# LOT 6 — multi-provider. JSON contains topology/model metadata only; secrets stay in their own env vars.
# Example compact value:
# AI_PROVIDERS_JSON=[{"name":"provider-a","base_url":"https://api.example/v1","api_key_env":"PROVIDER_A_KEY","models":[{"model":"flash","quality_tier":1,"cost_units":1,"max_context_tokens":8000,"capabilities":["chat"]}]}]
AI_PROVIDERS_JSON=

# Backward-compatible single-provider configuration.
# LOT 6 — provider OpenAI-compatible (DeepSeek/OpenAI-compatible or gateway)
AI_PROVIDER_NAME=external
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_FLASH_MODEL=
AI_REASONING_MODEL=
AI_FLASH_CREDITS=1
AI_REASONING_CREDITS=2
AI_FLASH_CONTEXT=8000
AI_REASONING_CONTEXT=16000

# Hard cost circuit breaker. In production 0 means external AI calls are blocked.
AI_DAILY_CREDIT_BUDGET=0
# Enable only after choosing a provider/privacy contract appropriate for personal documents.
AI_ALLOW_PERSONAL_DOCUMENTS=false

# LOT 7 — signature des autorisations de livraison de ressources communes.
# Obligatoire en production ; 64+ caractères aléatoires recommandés.
RESOURCE_DELIVERY_SECRET=

# LOT 8 content delivery (R2/S3-compatible)
CONTENT_STORAGE_BACKEND=s3
CONTENT_STORAGE_BUCKET=
CONTENT_STORAGE_ENDPOINT=
CONTENT_STORAGE_REGION=auto
# development/test only
CONTENT_STORAGE_LOCAL_ROOT=/tmp/edunova-content

# LOT 9
FCM_ENABLED=false

# LOT 12 — industrial ingestion
INGESTION_MAX_BATCH_FILES=1000
INGESTION_MAX_FILE_BYTES=83886080
INGESTION_MAX_PDF_PAGES=600
INGESTION_MAX_IMAGE_PIXELS=70000000
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=180
INGESTION_PENDING_SLA_MINUTES=30
INGESTION_STAGING_DIR=/tmp/edunova-ingestion
# Production: S3/R2 staging; if unset, CONTENT_STORAGE_BUCKET is reused.
INGESTION_STORAGE_BUCKET=
INGESTION_STORAGE_PREFIX=ingestion
# Optional service account used to create Studio drafts from workers.
INGESTION_SYSTEM_ACCOUNT_ID=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# LOT 30 — production operations
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
MFA_ENCRYPTION_KEY=
ATTENDANCE_QR_SECRET=
ATTENDANCE_PROXIMITY_SECRET=
